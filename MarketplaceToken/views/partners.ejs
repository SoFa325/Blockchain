<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Партнеры | Блокчейн Сервис</title>
    <link rel="stylesheet" href="/css/style.css">
    <style>
        .partners-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
            gap: 1.5rem;
            margin-top: 2rem;
        }
        
        .partner-card {
            border: 1px solid #e0e0e0;
            border-radius: 8px;
            overflow: hidden;
            transition: transform 0.3s, box-shadow 0.3s;
        }
        
        .partner-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 5px 15px rgba(0,0,0,0.1);
        }
        
        .partner-content {
            padding: 1.5rem;
        }
        
        .partner-title {
            margin-top: 0;
            color: #2c3e50;
        }
        
        .partner-tokens {
            display: flex;
            align-items: center;
            margin: 1rem 0;
            font-size: 1.2rem;
        }
        
        .token-icon {
            margin-right: 0.5rem;
            color: #f39c12;
        }
        
        .purchase-btn {
            width: 100%;
            padding: 0.75rem;
            background: #27ae60;
            color: white;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            transition: background 0.3s;
        }
        
        .purchase-btn:hover {
            background: #219653;
        }
        
        .purchase-btn:disabled {
            background: #95a5a6;
            cursor: not-allowed;
        }
        
        .user-balance {
            text-align: right;
            margin-bottom: 1rem;
            font-size: 1.1rem;
        }
        
        .balance-amount {
            font-weight: bold;
            color: #27ae60;
        }
    </style>
</head>
<body>
    <header>
        <h1>Партнеры и бонусы</h1>
        <a href="/lk" class="logout">Назад в кабинет</a>
    </header>

    <div class="container">
        <% if (typeof error !== 'undefined' && error) { %>
            <div class="error-message"><%= error %></div>
        <% } %>
        
        <% if (typeof message !== 'undefined' && message) { %>
            <div class="success-message"><%= message %></div>
        <% } %>
        
        <div class="user-balance">
            Ваш баланс: <span class="balance-amount"><%= tokenBalance %> MDT</span>
        </div>
        
        <div class="partners-grid">
            <% partners.forEach(partner => { %>
                <div class="partner-card">
                    <div class="partner-content">
                        <h3 class="partner-title"><%= partner.name %></h3>
                        <p><%= partner.description %></p>
                        
                        <div class="partner-tokens">
                            <span class="token-icon">🪙</span>
                            <span><%= partner.tokens %> MDT</span>
                        </div>
                        
                        <form action="/purchase-bonus" method="POST">
                            <input type="hidden" name="partnerId" value="<%= partner.id %>">
                            <button 
                                type="submit" 
                                class="purchase-btn"
                                <%= Number(tokenBalance) < partner.tokens ? 'disabled' : '' %>
                            >
                                Приобрести
                            </button>
                        </form>
                    </div>
                </div>
            <% }); %>
        </div>
    </div>
</body>
</html>
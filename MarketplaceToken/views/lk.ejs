<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Личный кабинет</title>
    <style>
        body { font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto; padding: 20px; }
        .info-block { margin-bottom: 20px; padding: 15px; border: 1px solid #ddd; border-radius: 5px; }
        .logout-btn { padding: 8px 15px; background: #f44336; color: white; border: none; border-radius: 4px; }
    </style>
</head>
<body>
    <h1>Личный кабинет</h1>
    
    <div class="info-block">
        <h2>Ваши данные</h2>
        <p><strong>Email:</strong> <%= user.email %></p>
        <p><strong>Блокчейн-аккаунт:</strong> <%= user.account %></p>
    </div>
    
    <div class="info-block">
        <h2>Балансы</h2>
        <p><strong>ETH:</strong> <%= balance %></p>
        <p><strong>Токены:</strong> <%= tokenBalance %></p>
    </div>
    
    <a href="/logout" class="logout-btn">Выйти</a>
</body>
</html>
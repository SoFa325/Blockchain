<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Блокчейн Авторизация</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <header>
        <h1>Блокчейн Сервис</h1>
    </header>

    <div class="container">
        <div class="auth-container">
            <% if (error) { %>
                <div class="error-message"><%= error %></div>
            <% } %>
            
            <% if (message) { %>
                <div class="success-message"><%= message %></div>
            <% } %>
            
            <h2 class="auth-title">Вход в систему</h2>
            
            <form action="/auth" method="POST" class="auth-form">
                <div class="form-group">
                    <label for="email">Email</label>
                    <input type="email" id="email" name="email" required class="form-input">
                </div>
                
                <div class="form-group">
                    <label for="blockchain_account">Blockchain Account</label>
                    <input type="text" id="blockchain_account" name="blockchain_account" required class="form-input">
                </div>
                
                <button type="submit" class="auth-button">Войти</button>
            </form>
            
            <div class="auth-links">
                <p>Нет аккаунта? <a href="/register">Зарегистрироваться</a></p>
            </div>
        </div>
    </div>
</body>
</html>